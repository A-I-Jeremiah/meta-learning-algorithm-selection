<?xml version="1.0" encoding="UTF-8"?>
<!--
  experiment.xsd
  ==============
  XML Schema modelling the meta-learning experiment structure.

  The schema describes the EXPERIMENT (not the raw benchmark datasets):

    Experiment
    +- Datasets
    |    +- Dataset (name, task, MetaFeatures)
    +- Algorithms
    |    +- Algorithm (name, Hyperparameters)
    +- Runs
         +- Run (datasetRef, algorithmRef, fold, metric, value)

  A Run records one cross-validation fold of one algorithm on one dataset,
  matching results/cv_results_long.csv. Dataset/Algorithm carry the
  descriptive metadata (meta-features, hyperparameters) referenced by Runs.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- ================================================================= -->
  <!-- Simple reusable types                                             -->
  <!-- ================================================================= -->

  <xs:simpleType name="TaskType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="binary"/>
      <xs:enumeration value="multiclass"/>
      <xs:enumeration value="regression"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MetricType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="accuracy"/>
      <xs:enumeration value="r2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AlgorithmName">
    <xs:restriction base="xs:string">
      <xs:enumeration value="RandomForest"/>
      <xs:enumeration value="GradientBoosting"/>
      <xs:enumeration value="SVM"/>
      <xs:enumeration value="kNN"/>
      <xs:enumeration value="NeuralNetwork"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonNegativeInt">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ================================================================= -->
  <!-- Meta-features (one element per meta-feature we extract)           -->
  <!-- ================================================================= -->

  <xs:complexType name="MetaFeaturesType">
    <xs:sequence>
      <xs:element name="n_instances" type="xs:double"/>
      <xs:element name="n_features" type="xs:double"/>
      <xs:element name="log_n_instances" type="xs:double"/>
      <xs:element name="log_n_features" type="xs:double"/>
      <xs:element name="feature_to_instance_ratio" type="xs:double"/>
      <xs:element name="n_classes" type="xs:double"/>
      <xs:element name="class_imbalance_ratio" type="xs:double"/>
      <xs:element name="normalised_class_entropy" type="xs:double"/>
      <xs:element name="mean_feature_std" type="xs:double"/>
      <xs:element name="mean_abs_coef_variation" type="xs:double"/>
      <xs:element name="mean_skewness" type="xs:double"/>
      <xs:element name="mean_kurtosis" type="xs:double"/>
      <xs:element name="mean_abs_feature_correlation" type="xs:double"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================= -->
  <!-- Dataset                                                           -->
  <!-- ================================================================= -->

  <xs:complexType name="DatasetType">
    <xs:sequence>
      <xs:element name="MetaFeatures" type="MetaFeaturesType"/>
    </xs:sequence>
    <!-- id is referenced by Run/@datasetRef via keyref -->
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="task" type="TaskType" use="required"/>
    <xs:attribute name="source" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ================================================================= -->
  <!-- Algorithm + hyperparameters                                       -->
  <!-- ================================================================= -->

  <xs:complexType name="HyperparameterType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="HyperparametersType">
    <xs:sequence>
      <xs:element name="Hyperparameter" type="HyperparameterType"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="AlgorithmType">
    <xs:sequence>
      <xs:element name="Hyperparameters" type="HyperparametersType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="name" type="AlgorithmName" use="required"/>
    <xs:attribute name="family" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ================================================================= -->
  <!-- Run (one CV fold of one algorithm on one dataset)                 -->
  <!-- ================================================================= -->

  <xs:complexType name="RunType">
    <xs:sequence>
      <xs:element name="Dataset" type="xs:string"/>
      <xs:element name="fold" type="NonNegativeInt"/>
      <xs:element name="metric" type="MetricType"/>
      <xs:element name="value" type="xs:double"/>
    </xs:sequence>
    <!-- references resolved by keyref against Dataset/@id, Algorithm/@id -->
    <xs:attribute name="datasetRef" type="xs:IDREF" use="required"/>
    <xs:attribute name="algorithmRef" type="xs:IDREF" use="required"/>
  </xs:complexType>

  <!-- ================================================================= -->
  <!-- Root: Experiment                                                  -->
  <!-- ================================================================= -->

  <xs:element name="Experiment">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Datasets">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Dataset" type="DatasetType"
                          maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Algorithms">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Algorithm" type="AlgorithmType"
                          maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Runs">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Run" type="RunType"
                          maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="title" type="xs:string" use="required"/>
      <xs:attribute name="cvFolds" type="NonNegativeInt" use="required"/>
    </xs:complexType>

    <!-- Referential integrity: every Run must reference a declared
         Dataset id and Algorithm id. xs:ID/xs:IDREF already enforce this,
         and the explicit key/keyref below document the relationship. -->
    <xs:key name="datasetKey">
      <xs:selector xpath="Datasets/Dataset"/>
      <xs:field xpath="@id"/>
    </xs:key>
    <xs:keyref name="runDatasetRef" refer="datasetKey">
      <xs:selector xpath="Runs/Run"/>
      <xs:field xpath="@datasetRef"/>
    </xs:keyref>

    <xs:key name="algorithmKey">
      <xs:selector xpath="Algorithms/Algorithm"/>
      <xs:field xpath="@id"/>
    </xs:key>
    <xs:keyref name="runAlgorithmRef" refer="algorithmKey">
      <xs:selector xpath="Runs/Run"/>
      <xs:field xpath="@algorithmRef"/>
    </xs:keyref>
  </xs:element>

</xs:schema>
